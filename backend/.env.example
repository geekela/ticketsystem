# Copy to backend/.env and fill in. Never commit .env.
# ANALYZER: anthropic (default) | mistral. Without the matching key,
# tickets are classified by keywords.
ANALYZER=anthropic
ANTHROPIC_API_KEY=
# Optional: defaults to claude-opus-5-5
ANTHROPIC_MODEL=
# Required only for organization-scoped keys
ANTHROPIC_WORKSPACE_ID=
MISTRAL_API_KEY=
